{
  "name": "dsh-run-button",
  "version": "0.1.0",
  "description": "Run button for shell code blocks in DSH replies: executes the snippet through the host shell service and streams its output to a bottom-right dock, or to a bottom-panel tab per run.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwardXiao-bit/dsh-run-button.git"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "scripts/check-client.mjs",
    "scripts/simulate-client.mjs",
    "scripts/test-host-mount.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "cordis",
    "code-block",
    "run-button",
    "shell",
    "terminal",
    "command",
    "bottom-panel",
    "web-ui",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "dsh-better-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node scripts/check-client.mjs && node scripts/simulate-client.mjs && node scripts/test-host-mount.mjs",
    "simulate": "node scripts/simulate-client.mjs",
    "test:host": "node scripts/test-host-mount.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5"
  }
}
